<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AgentsphereHealthKit</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Air Agents</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.abhisheksatpathy.agentsphere</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>agentsphere</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Your agents can set alarms and timers when you ask.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Your agents can tell you what's on your calendar and add events when you ask.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Your agents can tell you about your steps, sleep, workouts and heart rate when you ask. Health data stays on your iPhone except for the answer to your question.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Air Agents doesn't write to Apple Health.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Air Agents can tell you when an agent is nearby.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>FindAgents</key>
		<string>Precise location lets you find agents placed a few metres away.</string>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Air Agents uses your location to find agents placed nearby and to place your own.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Air Agents listens when you face an agent so you can talk to it hands-free.</string>
	<key>NSMotionUsageDescription</key>
	<string>AirPods head tracking lets you face an agent to select it and nod or shake to answer.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Your agents can read your to-dos and add or tick off reminders when you ask.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your words are transcribed on-device and sent to the agent you're talking to.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
